# Versión personal: solo datos inventados o propios, nunca datos de clientes.
# Copia este archivo como .env. Nunca subas .env al repositorio.

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000

# --- IA con OpenRouter (opcional) ---
# false = la app funciona solo con reglas, sin IA.
AI_ENABLED=false
# Slug del modelo en OpenRouter, formato proveedor/modelo (catálogo: https://openrouter.ai/models)
AI_MODEL=
OPENROUTER_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4000
# Vacío = no se envía (algunos modelos no lo aceptan).
AI_TEMPERATURE=
# true solo si el modelo soporta salida JSON nativa.
AI_JSON_MODE=false
AI_RATE_LIMIT_PER_MINUTE=10
# true = solo endpoints con cero retención de datos.
OPENROUTER_ZDR=true
OPENROUTER_APP_TITLE=Security Tech AI (personal)
